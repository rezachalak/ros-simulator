<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="simple_robot">

    <!-- ── Base body ───────────────────────────────────────────────────── -->
    <link name="base_link">
      <pose>0 0 0.07 0 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.0166</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0230</iyy><iyz>0</iyz>
          <izz>0.0380</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry><box><size>0.30 0.20 0.08</size></box></geometry>
      </collision>
      <visual name="base_visual">
        <geometry><box><size>0.30 0.20 0.08</size></box></geometry>
        <material>
          <ambient>0.2 0.7 0.2 1</ambient>
          <diffuse>0.2 0.8 0.2 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>

    <!-- ── Left wheel ──────────────────────────────────────────────────── -->
    <link name="left_wheel">
      <pose>0.0 0.12 0.05 -1.5707963 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.000195</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000195</iyy><iyz>0</iyz>
          <izz>0.000375</izz>
        </inertia>
      </inertial>
      <collision name="left_wheel_col">
        <geometry><cylinder><radius>0.05</radius><length>0.02</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="left_wheel_vis">
        <geometry><cylinder><radius>0.05</radius><length>0.02</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><effort>10</effort><velocity>10</velocity></limit>
        <dynamics><damping>0.01</damping></dynamics>
      </axis>
    </joint>

    <!-- ── Right wheel ─────────────────────────────────────────────────── -->
    <link name="right_wheel">
      <pose>0.0 -0.12 0.05 -1.5707963 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.000195</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000195</iyy><iyz>0</iyz>
          <izz>0.000375</izz>
        </inertia>
      </inertial>
      <collision name="right_wheel_col">
        <geometry><cylinder><radius>0.05</radius><length>0.02</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="right_wheel_vis">
        <geometry><cylinder><radius>0.05</radius><length>0.02</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><effort>10</effort><velocity>10</velocity></limit>
        <dynamics><damping>0.01</damping></dynamics>
      </axis>
    </joint>

    <!-- ── Caster (passive front wheel) ────────────────────────────────── -->
    <link name="caster_link">
      <pose>0.12 0 0.025 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.00004</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00004</iyy><iyz>0</iyz>
          <izz>0.00004</izz>
        </inertia>
      </inertial>
      <collision name="caster_col">
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <surface>
          <friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="caster_vis">
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <material><ambient>0.5 0.5 0.5 1</ambient></material>
      </visual>
    </link>

    <joint name="caster_joint" type="ball">
      <parent>base_link</parent>
      <child>caster_link</child>
    </joint>

    <!-- ── Lidar sensor ─────────────────────────────────────────────────── -->
    <link name="lidar_link">
      <pose>0.0 0 0.14 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.000004</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000004</iyy><iyz>0</iyz>
          <izz>0.000004</izz>
        </inertia>
      </inertial>
      <visual name="lidar_vis">
        <geometry><cylinder><radius>0.04</radius><length>0.04</length></cylinder></geometry>
        <material>
          <ambient>0.8 0.2 0.2 1</ambient>
          <diffuse>0.9 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <collision name="lidar_col">
        <geometry><cylinder><radius>0.04</radius><length>0.04</length></cylinder></geometry>
      </collision>

      <sensor name="lidar" type="ray">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.10</min>
            <max>5.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>

        <!-- Publish as sensor_msgs/LaserScan on /scan -->
        <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <remapping>~/out:=scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>lidar_link</frame_name>
        </plugin>
      </sensor>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <!-- ── Differential drive plugin ───────────────────────────────────── -->
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <update_rate>30</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.24</wheel_separation>
      <wheel_diameter>0.10</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <ros>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>

  </model>
</sdf>
