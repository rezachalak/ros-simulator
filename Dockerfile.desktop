FROM osrf/ros:iron-desktop

# GUI stack: virtual framebuffer + VNC + noVNC web proxy
# Simulation:  Gazebo 8  (ros-iron-gazebo-ros-pkgs)
# DDS:         CycloneDDS
RUN apt-get update && apt-get install -y \
    # Display / VNC
    xvfb \
    x11vnc \
    novnc \
    websockify \
    openbox \
    # Gazebo
    ros-iron-gazebo-ros-pkgs \
    ros-iron-gazebo-ros \
    # DDS
    ros-iron-rmw-cyclonedds-cpp \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/start_desktop.sh /start_desktop.sh
RUN chmod +x /start_desktop.sh

EXPOSE 8080 5900

ENTRYPOINT ["/start_desktop.sh"]
