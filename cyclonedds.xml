<?xml version="1.0" encoding="UTF-8" ?>
<!--
  CycloneDDS configuration for Docker bridge networking.
  Binds to eth0 and uses IP multicast for ROS 2 node discovery across containers.
  Requires a runtime that exposes IP_MULTICAST_IF on eth0 (Colima with vz works;
  Docker Desktop for Mac does not).
-->
<CycloneDDS xmlns="https://cdds.io/config"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="https://cdds.io/config
              https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">
  <Domain Id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="eth0" />
      </Interfaces>
      <AllowMulticast>true</AllowMulticast>
    </General>
  </Domain>
</CycloneDDS>
